# Job: сборка контекста ${project} через Kaniko в Managed Yandex K8s.
#  - контекст: git-ветка ${git_branch} репозитория ${git_url}, клонируется
#    init-контейнером git-clone прямо в /workspace (Dockerfile + исходники в корне ветки).
#    Сборка идёт из локального /workspace (dir:///workspace).
#    (Классическая схема: контекст — git-репозиторий; ветка на проект.)
#  - auth: короткоживущий IAM-токен из метаданных ноды (сервисного аккаунта)
#    -> docker config в /kaniko/.docker
#  - замер времени: wrapper /scripts/time-build.sh (из ConfigMap scripts) пишет в /artifacts/times.txt
#  - результат пушится в Yandex Container Registry: registry.yandex.cloud/<id>/${project}-kaniko:<tag>
#  - registry-кэш: --cache-repo registry.yandex.cloud/<id>/${project}-kaniko-cache
#
# Генерируется Terraform'ом из benchmark/kaniko/kaniko-job.yaml.tftpl,
# registry_id, project, git_url, git_branch подставляются в benchmark.tf.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${project}-kaniko-build
  namespace: kaniko-benchmark
  labels:
    app: kaniko-buildkit-benchmark
    tool: kaniko
    project: ${project}
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        app: kaniko-buildkit-benchmark
        tool: kaniko
        project: ${project}
    spec:
      restartPolicy: Never
      initContainers:
# Клонируем ветку проекта репозитория прямо в /workspace (Dockerfile + исходники в корне ветки).
        - name: git-clone
          image: alpine/git:v2.54.0
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              git clone --depth 1 --branch "$${GIT_BRANCH}" "$${GIT_URL}" /workspace
              ls -la /workspace
          env:
            - name: GIT_URL
              value: ${git_url}
            - name: GIT_BRANCH
              value: ${git_branch}
          volumeMounts:
            - name: workdir
              mountPath: /workspace
        # Регистрируем авторизацию через IAM-токен до старта основного контейнера.
        - name: auth
          image: alpine:3.20
          command:
            - /bin/sh
            - -c
            - |
              TOKEN=$(/scripts/get-iam-token.sh)
              /scripts/write-docker-config.sh /kaniko/.docker iam "$TOKEN"
          volumeMounts:
            - name: kaniko-docker
              mountPath: /kaniko/.docker
            - name: scripts
              mountPath: /scripts
      containers:
        - name: kaniko
          image: gcr.io/kaniko-project/executor:v1.23.2-debug
          command:
            - /bin/sh
            - -c
            - |
              # ждать, пока init-container запишет config (общий volume)
              until [ -f /kaniko/.docker/config.json ]; do sleep 1; done
              exec /scripts/time-build.sh ${project}-kaniko \
                /kaniko/executor \
                --dockerfile=Dockerfile \
                --context=dir:///workspace \
                --destination=registry.yandex.cloud/${registry_id}/${project}-kaniko:latest \
                --cache=true \
                --cache-repo=registry.yandex.cloud/${registry_id}/${project}-kaniko-cache
          env:
            - name: DOCKER_CONFIG
              value: /kaniko/.docker
          resources:
            requests:
              cpu: "1000m"
              memory: "1Gi"
            limits:
              cpu: "4000m"
              memory: "4Gi"
          volumeMounts:
            - name: workdir
              mountPath: /workspace
            - name: kaniko-docker
              mountPath: /kaniko/.docker
            - name: scripts
              mountPath: /scripts
            - name: artifacts
              mountPath: /artifacts
      volumes:
        - name: workdir
          emptyDir: {}
        - name: kaniko-docker
          emptyDir: {}
        - name: scripts
          configMap:
            name: benchmark-scripts
          defaultMode: 0755
        - name: artifacts
          emptyDir: {}