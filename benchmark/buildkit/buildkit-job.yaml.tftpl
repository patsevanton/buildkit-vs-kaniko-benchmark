# Job: сборка контекста ${project} через BuildKit (daemonless, root) в Managed Yandex K8s.
#  - контекст: ConfigMap build-context-${project} (Dockerfile + исходники), mount в /workspace
#  - auth: IAM-токен из метаданных ноды -> ~/.docker/config.json (docker config)
#  - как и kaniko, демон buildkitd работает от root; никакого Unconfined/user-namespaces нет
#  - кэш: registry-кэш через --import-cache/--export-cache type=registry
#    в registry.yandex.cloud/<id>/${project}-buildkit-cache. Локального кэша между прогонами нет:
#    buildkitd во время сборки держит эфемерный кэш во встроенном VOLUME образа.
#  - замер времени: wrapper /scripts/time-build.sh пишет в /artifacts/times.txt
#  - результат пушится в Yandex Container Registry: registry.yandex.cloud/<id>/${project}-buildkit:<tag>
#
# Образ moby/buildkit:v0.32.2 (root). Запускается через buildctl-daemonless.sh:
# поднимает встроенный buildkitd внутри того же контейнера.
#
# Генерируется Terraform'ом из benchmark/buildkit/buildkit-job.yaml.tftpl,
# registry_id и project подставляются в benchmark.tf.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${project}-buildkit-build
  namespace: kaniko-benchmark
  labels:
    app: kaniko-buildkit-benchmark
    tool: buildkit
    project: ${project}
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        app: kaniko-buildkit-benchmark
        tool: buildkit
        project: ${project}
    spec:
      restartPolicy: Never
      initContainers:
# Материализуем дерево контекста из плоского ConfigMap (ключи с __ -> /).
        - name: setup-workspace
          image: alpine:3.20
          command:
            - /bin/sh
            - -c
            - |
              /scripts/setup-workspace.sh
          env:
            - name: SRC_DIR
              value: /config
            - name: DST_DIR
              value: /workspace
            - name: TARGET_UID
              value: "0"
          volumeMounts:
            - name: build-context
              mountPath: /config
            - name: workdir
              mountPath: /workspace
            - name: scripts
              mountPath: /scripts
# Записываем registry auth в /root/.docker/config.json.
        - name: auth
          image: alpine:3.20
          command:
            - /bin/sh
            - -c
            - |
              TOKEN=$(/scripts/get-iam-token.sh)
              /scripts/write-docker-config.sh /root/.docker iam "$TOKEN"
              mkdir -p /artifacts
          volumeMounts:
            - name: docker-config
              mountPath: /root/.docker
            - name: scripts
              mountPath: /scripts
            - name: artifacts
              mountPath: /artifacts
      containers:
        - name: buildkit
          image: moby/buildkit:v0.32.2
          command:
            - /bin/sh
            - -c
            - |
              until [ -f /root/.docker/config.json ]; do sleep 1; done
              exec /scripts/time-build.sh ${project}-buildkit \
                buildctl-daemonless.sh build \
                  --frontend dockerfile.v0 \
                  --local context=/workspace \
                  --local dockerfile=/workspace \
                  --output type=image,name=registry.yandex.cloud/${registry_id}/${project}-buildkit:latest,push=true \
                  --import-cache type=registry,ref=registry.yandex.cloud/${registry_id}/${project}-buildkit-cache \
                  --export-cache type=registry,ref=registry.yandex.cloud/${registry_id}/${project}-buildkit-cache,mode=max
          resources:
            requests:
              cpu: "1000m"
              memory: "1Gi"
            limits:
              cpu: "4000m"
              memory: "4Gi"
          volumeMounts:
            - name: workdir
              mountPath: /workspace
            - name: docker-config
              mountPath: /root/.docker
            - name: scripts
              mountPath: /scripts
            - name: artifacts
              mountPath: /artifacts
      volumes:
        - name: build-context
          configMap:
            name: build-context-${project}
        - name: workdir
          emptyDir: {}
        - name: docker-config
          emptyDir: {}
        - name: scripts
          configMap:
            name: benchmark-scripts
          defaultMode: 0755
        - name: artifacts
          emptyDir: {}