# Job: сборка одного и того же образа через BuildKit (daemonless, rootless)
# в Managed Yandex K8s.
#  - контекст: ConfigMap build-context (Dockerfile + app.py + app.sh), mount в /workspace
#  - auth: IAM-токен из метаданных ноды -> ~/.docker/config.json (пользователь UID 1000)
#  - замер времени: wrapper /scripts/time-build.sh пишет в /artifacts/times.txt
#  - результат пушится в Yandex Container Registry: registry.yandex.cloud/<id>/buildkit:<tag>
#
# Образ moby/buildkit:v0.32.2-rootless (alpine-based, пользователь "user" UID 1000, home /home/user).
# Запускается через buildctl-daemonless.sh: поднимает встроенный buildkitd внутри того же контейнера.
#
# Генерируется Terraform'ом из benchmark/buildkit/buildkit-job.yaml.tftpl,
# registry_id подставляется из yandex_container_registry.registry.id.
apiVersion: batch/v1
kind: Job
metadata:
  name: buildkit-build
  namespace: kaniko-benchmark
  labels:
    app: kaniko-buildkit-benchmark
    tool: buildkit
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        app: kaniko-buildkit-benchmark
        tool: buildkit
    spec:
      restartPolicy: Never
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      initContainers:
# Записываем registry auth в ~/.docker/config.json пользователя UID 1000.
        - name: auth
          image: alpine:3.20
          command:
            - /bin/sh
            - -c
            - |
              TOKEN=$(/scripts/get-iam-token.sh)
              /scripts/write-docker-config.sh /home/user/.docker iam "$TOKEN"
              # Основной контейнер buildkit работает от UID 1000 — отдаём ему файлы.
              chown -R 1000:1000 /home/user/.docker
              mkdir -p /artifacts && chown -R 1000:1000 /artifacts
          volumeMounts:
            - name: docker-config
              mountPath: /home/user/.docker
            - name: scripts
              mountPath: /scripts
            - name: artifacts
              mountPath: /artifacts
      containers:
        - name: buildkit
          image: moby/buildkit:v0.32.2-rootless
          env:
            - name: BUILDKITD_FLAGS
              value: --oci-worker-no-process-sandbox
          command:
            - /bin/sh
            - -c
            - |
              until [ -f /home/user/.docker/config.json ]; do sleep 1; done
              exec /scripts/time-build.sh buildkit \
                buildctl-daemonless.sh build \
                  --frontend dockerfile.v0 \
                  --local context=/workspace \
                  --local dockerfile=/workspace \
                  --output type=image,name=registry.yandex.cloud/${registry_id}/buildkit-benchmark:latest,push=true
          resources:
            requests:
              cpu: "1000m"
              memory: "1Gi"
            limits:
              cpu: "4000m"
              memory: "4Gi"
          securityContext:
            seccompProfile:
              type: Unconfined
            # Needs Kubernetes >= 1.30
            appArmorProfile:
              type: Unconfined
            runAsUser: 1000
            runAsGroup: 1000
          volumeMounts:
            - name: build-context
              readOnly: true
              mountPath: /workspace
            - name: docker-config
              mountPath: /home/user/.docker
            - name: buildkitd
              mountPath: /home/user/.local/share/buildkit
            - name: scripts
              mountPath: /scripts
            - name: artifacts
              mountPath: /artifacts
      volumes:
        - name: build-context
          configMap:
            name: build-context
        - name: docker-config
          emptyDir: {}
        - name: buildkitd
          emptyDir: {}
        - name: scripts
          configMap:
            name: benchmark-scripts
          defaultMode: 0755
        - name: artifacts
          emptyDir: {}